<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example.datamask4j</groupId><artifactId>spring-boot-consumer</artifactId><version>1.0.0-SNAPSHOT</version>
  <!-- Deliberately no DataMask4j parent or reactor modules. -->
  <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.13.4</junit.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- Build-only overrides; no new application runtime dependencies. -->
        <plugin.plexus-utils.v3>3.6.4</plugin.plexus-utils.v3>
        <plugin.plexus-utils.v4>4.0.3</plugin.plexus-utils.v4>
        <plugin.commons-io>2.22.0</plugin.commons-io>
        <plugin.commons-lang3>3.18.0</plugin.commons-lang3>
        <plugin.snappy>0.5</plugin.snappy>
        <plugin.plexus-archiver>4.16.0</plugin.plexus-archiver>
        <plugin.maven-filtering>3.5.1</plugin.maven-filtering>
    </properties>
  <dependencies>
    <dependency><groupId>io.github.hamzador</groupId><artifactId>datamask4j-spring-boot-starter</artifactId><version>0.1.0</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><pluginManagement><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version><dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils.v4}</version>
                        </dependency>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io}</version>
                        </dependency>
                    </dependencies></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version><dependencies>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>${plugin.commons-lang3}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils.v3}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.maven.shared</groupId>
                            <artifactId>maven-filtering</artifactId>
                            <version>${plugin.maven-filtering}</version>
                        </dependency>
                    </dependencies></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version><dependencies>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>${plugin.commons-lang3}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils.v4}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.iq80.snappy</groupId>
                            <artifactId>snappy</artifactId>
                            <version>${plugin.snappy}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-archiver</artifactId>
                            <version>${plugin.plexus-archiver}</version>
                        </dependency>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io}</version>
                        </dependency>
                    </dependencies></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version><dependencies>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils.v4}</version>
                        </dependency>
                    </dependencies></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version><dependencies>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io}</version>
                        </dependency>
                    </dependencies></plugin></plugins></pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.1.4</version><configuration><skip>true</skip></configuration></plugin>
  </plugins></build>
</project>
